# Local Docker Desktop MongoDB, published on host port 27017.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=surakshanethra_demo

# Replace with a long random demo key and share it only with authorized demo users.
DEMO_API_KEY=replace-with-a-long-random-demo-key

# If serving the dashboard separately, list its exact browser origins here.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Approved clips only; raw video is never uploaded before consent.
EVIDENCE_DIRECTORY=./evidence_uploads


# Optional: absolute path to Firebase Admin service-account JSON for push delivery.
FIREBASE_SERVICE_ACCOUNT_PATH=
